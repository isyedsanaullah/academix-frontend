# ─── Academix Frontend Environment Variables (Example) ───

# ─── Backend API Connection ───
NEXT_PUBLIC_API_URL=https://academix-backend-8zcg.onrender.com/api
BACKEND_URL=https://academix-backend-8zcg.onrender.com
NEXT_PUBLIC_ROOT_DOMAIN=collegeshub.org

# ─── Firebase Auth & Services (Replace with your Firebase project credentials) ───
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
